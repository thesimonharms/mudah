{
  "name": "@mudah-cli/vgpu",
  "version": "0.4.1",
  "description": "Run vgpu WGSL effects inside a Mudah app and blit the pixels to the terminal (Kitty graphics, with a half-block fallback).",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "exports": {
