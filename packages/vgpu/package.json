    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "dependencies": {
    "@mudah-cli/terminal": "^0.4.0",
    "vgpu": "^0.3.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
