{
  "name": "Mudah Command",
  "scopeName": "source.ts.mudah.command",
  "fileTypes": ["command.ts"],
  "patterns": [
    {
      "name": "meta.mudah.signature",
      "match": "\\b(signature)\\s*=",
      "captures": {
        "1": { "name": "keyword.other.mudah.signature" }
      }
    },
    {
      "name": "meta.mudah.description",
      "match": "\\b(description)\\s*=",
      "captures": {
        "1": { "name": "keyword.other.mudah.description" }
      }
    },
    {
      "name": "meta.mudah.handle",
      "match": "\\b(?:async\\s+)?(handle)\\s*\\(",
      "captures": {
        "1": { "name": "entity.name.function.mudah.handle" }
      }
    },
    {
      "include": "source.ts"
    }
  ]
}
